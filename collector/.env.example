# Копировать в collector/.env (имена переменных должны совпадать с os.getenv в коде)

# Источники данных
HN_API_URL=https://hacker-news.firebaseio.com/v0
DEVTO_API_URL=https://dev.to/api/articles
DEVTO_DAYS=7
DEVTO_PER_PAGE=50

# Локальная Ollama (если недоступна — автоматический fallback по ключевым словам)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:0.5b

# MongoDB (читается через backend/database.py)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=trendradar
