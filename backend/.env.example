# Ключ для очистки базы через POST /api/admin/clear (заголовок X-Admin-Key).
# Обязателен: если пусто, админ-эндпоинты отвечают 503. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_KEY=

# Локальная Ollama для AI-саммари
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# GitHub OAuth
